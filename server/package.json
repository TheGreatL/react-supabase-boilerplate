{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "kysely-codegen --out-file src/shared/database/db.types.ts --env-file .env",
    "db:make": "tsx scripts/make-migration.ts",
    "db:migrate": "kysely migrate:latest",
    "db:push": "kysely migrate:latest",
    "db:seed": "tsx src/shared/database/seed.ts",
    "db:reset": "kysely migrate:rollback --all && kysely migrate:latest && tsx src/shared/database/seed.ts",
    "start:docker": "npm run db:migrate && nodemon",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.4.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.6",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/helmet": "^0.0.48",
    "@types/http-status": "^0.2.30",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.28.16",
    "morgan": "^1.10.1",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "resend": "^6.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.3.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.18.0",
